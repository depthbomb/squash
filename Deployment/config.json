{
    "applicationName": "Squash",
    "initialVersion": "3.0.0",
    "launchExecutable": "Squash.exe",
    "windowIconPath": "../Squash/Resources/icon.ico",
    "requiredAppRuntimeVersion": "2.4.0",
    "requiredAppRuntimeArchitecture": "auto",
    "appearance": {
        "bannerBackgroundColor": "#f78c32"
    },
    "text": {
        "windowTitle": "{ApplicationName} Updater"
    },
    "installation": {
        "requireIntegrityVerification": true,
        "processName": "Squash",
        "keepLastVersions": 3,
        "extractionLayout": "auto",
        "allowFreshInstall": true,
        "compressFiles": true,
        "launchHealthTimeoutSeconds": 0
    },
    "updatePolicy": {
        "mode": "optional",
        "minimumVersion": ""
    },
    "requiredRuntimes": [
        {
            "name": "Microsoft.WindowsDesktop.App",
            "version": "10.0.11",
            "type": "windowsdesktop-runtime",
            "architecture": "auto"
        }
    ],
    "updateSource": {
        "type": "github",
        "repository": "depthbomb/squash",
        "includePrerelease": false,
        "channel": "stable"
    }
}
